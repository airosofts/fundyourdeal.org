# ── AiroBase (same setup as honestofferhome) ────────────────────────────
# Project URL and the SECRET key (server-only; bypasses RLS). Run
# airobase/001_gable_funding.sql in the project's SQL editor first.
NEXT_PUBLIC_AIROBASE_URL=
AIROBASE_SECRET_KEY=

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fundyourdeal.org
# Search engines stay out until this is "true" (set it on the live domain only).
NEXT_PUBLIC_INDEXABLE=false
# Google Tag Manager container (GA4 + Google Ads conversions live in GTM).
NEXT_PUBLIC_GTM_ID=
