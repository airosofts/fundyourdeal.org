# ── AiroBase: the shared project Gable Funding also writes to (gf_* tables) ──
# Project URL plus the SECRET key. The key is server-only and bypasses RLS.
# The SQL in airobase/ has already been run on the shared database; see README.
NEXT_PUBLIC_AIROBASE_URL=
AIROBASE_SECRET_KEY=

# ── Site ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are baked in at build time: set them before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://fundyourdeal.org
# "true" on fundyourdeal.org only; anything else keeps every page noindex.
NEXT_PUBLIC_INDEXABLE=false
# Google Tag Manager container ID (GA4 and the Google Ads conversions are set up in GTM).
NEXT_PUBLIC_GTM_ID=
